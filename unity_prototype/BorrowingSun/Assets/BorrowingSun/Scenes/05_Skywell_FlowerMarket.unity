  m_Script: {fileID: 11500000, guid: 8a4d4c1495ec448099374e35a0fe45e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: BorrowingSun.Runtime::BorrowingSun.SkywellStory
  court: {fileID: 887768187}
  observation: {fileID: 1306425345}
  collector: {fileID: 542866038}
  inspectionPoint: {fileID: 981252499}
  northNpc: {fileID: 228117228}
  eastNpc: {fileID: 32710686}
  interactionRadius: 2.5
  inspectionSpeaker: "\u91C7\u65E5\u955C"
  northSpeaker: "\u5B88\u955C\u4EBA"
  eastSpeaker: "\u5B88\u706F\u4EBA"
  brokenLines:
  - "\u5E74\u4E45\u5931\u4FEE\uFF0C\u9700\u8981\u586B\u8865\u955C\u5FC3\u3002\u8FD9\u91CC\u7F3A\u4E86\u4E00\u5757\u83F1\u5F62\u7684\u96C6\u5149\u77F3\u3002"
  repairLines:
  - "\u8FD9\u5757\u83F1\u5F62\u96C6\u5149\u77F3\uFF0C\u4E0E\u955C\u5FC3\u7684\u7F3A\u53E3\u6070\u597D\u543B\u5408\u3002"
  - "\u5C06\u96C6\u5149\u77F3\u5D4C\u5165\u955C\u5FC3\uFF0C\u8BA9\u8FD9\u9762\u8001\u955C\u91CD\u65B0\u63A5\u4F4F\u65E5\u5149\u3002"
  repairedLines:
  - "\u955C\u5FC3\u5DF2\u7ECF\u8865\u597D\u3002\u98CE\u80FD\u8F6C\u52A8\u955C\u9762\uFF0C\u6674\u5929\u4F1A\u8BA9\u65E5\u5149\u843D\u8FDB\u955C\u5FC3\u3002"
  repairFailureLine: "\u96C6\u5149\u77F3\u8FD8\u6CA1\u6709\u5D4C\u7A33\uFF0C\u5148\u6536\u597D\u5B83\uFF0C\u518D\u68C0\u67E5\u4E00\u6B21\u955C\u5FC3\u3002"
  northHintLines:
  - "\u5C71\u9633\u4E5F\u6709\u7167\u4E0D\u5230\u7684\u6A90\u89D2\uFF0C\u5C71\u9634\u4E5F\u6709\u4EBA\u5B88\u7740\u706F\u3002"
  - "\u5149\u660E\u4E2D\u6709\u9ED1\u6697\uFF0C\u9ED1\u6697\u4E2D\u4EA6\u6709\u5149\u660E\u3002\u53BB\u5BF9\u5CB8\u95EE\u95EE\u5B88\u706F\u4EBA\u5427\u3002"
  northGemLines:
  - "\u539F\u6765\u90A3\u5757\u955C\u5FC3\u4E00\u76F4\u88AB\u59A5\u5584\u6536\u7740\u3002\u628A\u5B83\u653E\u56DE\u91C7\u65E5\u955C\u5427\uFF0C\u8001\u955C\u8FD8\u7B49\u7740\u518D\u7167\u4E00\u6B21\u5BF9\u5CB8\u3002"
  northRepairedLines:
  - "\u955C\u5FC3\u5DF2\u7ECF\u8865\u597D\u3002\u8BA9\u98CE\u628A\u955C\u9762\u8F6C\u5411\u4E2D\u592E\u63A5\u529B\u955C\uFF0C\u518D\u501F\u4E00\u7247\u6674\u5929\uFF0C\u5C31\u770B\u89C1\u5149\u8981\u8D70\u7684\u8DEF\u4E86\u3002"
  northRewardLines:
  - "\u770B\uFF0C\u5149\u5DF2\u7ECF\u8FC7\u6865\u4E86\u3002\u5B88\u706F\u7684\u4EBA\u7EC8\u4E8E\u7B49\u5230\u4E86\u8FD9\u4E00\u523B\u3002"
  eastBeforeViewLines:
  - "\u5148\u5230\u63A5\u5149\u76D8\u8FB9\uFF0C\u770B\u770B\u6211\u4EEC\u7684\u6751\u5B50\u5427\u3002"
  eastGiftLines:
  - "\u7956\u7236\u8BF4\uFF0C\u5411\u9633\u5C71\u7684\u8001\u955C\u66FE\u628A\u65E5\u5149\u9001\u5230\u8FD9\u91CC\u3002\u540E\u6765\u955C\u5FC3\u7834\u635F\uFF0C\u8FD9\u4E00\u4FA7\u4FBF\u53EA\u5269\u7A97\u91CC\u7684\u706F\u3002"
  - "\u8FD9\u5757\u96C6\u5149\u77F3\u662F\u7956\u7236\u7559\u4E0B\u7684\uFF0C\u4E00\u76F4\u7531\u6211\u4EEC\u5B88\u7740\u3002\u8BF7\u628A\u5B83\u5E26\u56DE\u5BF9\u5CB8\uFF0C\u8865\u4E0A\u91C7\u65E5\u955C\u7F3A\u5931\u7684\u955C\u5FC3\u3002"
  - "\u8BA9\u65E5\u5149\u518D\u8FC7\u4E00\u6B21\u6865\u2014\u2014\u62DC\u6258\u4E86\u3002"
  eastGemGivenLines:
  - "\u96C6\u5149\u77F3\u5DF2\u7ECF\u4EA4\u7ED9\u4F60\u4E86\u3002\u5411\u9633\u5C71\u7684\u91C7\u65E5\u955C\uFF0C\u5C31\u6258\u4ED8\u7ED9\u4F60\u4E86\u3002"
  eastRepairedLines:
  - "\u7956\u7236\u7559\u4E0B\u7684\u955C\u5FC3\uFF0C\u53C8\u56DE\u5230\u8001\u955C\u91CC\u4E86\u3002\u6211\u4EEC\u4F1A\u5728\u8FD9\u91CC\u7B49\u5B83\u63A5\u4F4F\u65E5\u5149\u3002"
  eastRewardLines:
  - "\u65E5\u5149\u771F\u7684\u8FC7\u6865\u4E86\u3002\u8C22\u8C22\u4F60\uFF0C\u628A\u7956\u7236\u7684\u8BDD\u53D8\u6210\u4E86\u773C\u524D\u7684\u98CE\u666F\u3002"
  cameraBlendSeconds: 0.25
  dialogueFieldOfView: 45
  inspectionCameraOffset: {x: 3, y: 6, z: 5.5}
  northCameraOffset: {x: 2.8, y: 1.1, z: -3.4}
  eastCameraOffset: {x: -2.8, y: 1.1, z: -3.4}
